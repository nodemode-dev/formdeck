#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: ./build [options]

Builds the FormDeck desktop app from a fresh checkout in one step: checks and
fixes the toolchain, installs the engine and window dependencies, builds the
window, freezes the engine into the app, and bundles the app for this system.

  --debug           debug build (faster to compile, larger, unoptimised)
  --bundles LIST    bundle types, comma separated (default: app,dmg on macOS,
                    deb,rpm,appimage on Linux)
  --clean           remove earlier build output first
  --reinstall       reinstall Python and npm packages even if unchanged
  --yes             install missing system packages and Rust without asking
  -h, --help        this text

Needs Python 3.12+, Node 20.19+ and, on macOS, the Xcode Command Line Tools.
Rust is installed with rustup if it is missing. Windows: use formdeck.bat.
EOF
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

DEBUG=0
BUNDLES=""
CLEAN=0
REINSTALL=0
YES=0
while [ $# -gt 0 ]; do
  case "$1" in
    --debug) DEBUG=1 ;;
    --bundles) shift; BUNDLES="${1:-}" ;;
    --bundles=*) BUNDLES="${1#--bundles=}" ;;
    --clean) CLEAN=1 ;;
    --reinstall) REINSTALL=1 ;;
    --yes|-y) YES=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

START=$SECONDS
STEP=0
say() { printf '\033[1m[build]\033[0m %s\n' "$*"; }
step() { STEP=$((STEP + 1)); printf '\n\033[1m[build %d]\033[0m %s\n' "$STEP" "$*"; }
die() { printf '\n\033[1;31m[build] stopped:\033[0m %s\n' "$*" >&2; exit 1; }
ask() {
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || return 1
  local a
  read -r -p "[build] $* [y/N] " a
  case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
hash_of() { cat "$@" 2>/dev/null | { shasum -a 256 2>/dev/null || sha256sum; } | awk '{print $1}'; }

case "$(uname -s)" in
  Darwin) OS=macos ;;
  Linux) OS=linux ;;
  *) die "this script builds on macOS and Linux; on Windows run: formdeck.bat install, then formdeck.bat desktop build" ;;
esac
ARCH="$(uname -m)"
[ -n "$BUNDLES" ] || { [ "$OS" = macos ] && BUNDLES="app,dmg" || BUNDLES="deb,rpm,appimage"; }

step "checking the system ($OS, $ARCH)"

if [ "$OS" = macos ]; then
  xcode-select -p >/dev/null 2>&1 || die "the Xcode Command Line Tools are missing. Run: xcode-select --install (a window opens), then run ./build again"
fi

if [ "$OS" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  pkgs="libwebkit2gtk-4.1-dev build-essential curl wget file pkg-config libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf rpm"
  if command -v apt-get >/dev/null 2>&1 && ask "WebKitGTK and the other Tauri build packages are missing. Install them with apt-get now?"; then
    sudo_cmd=""; [ "$(id -u)" = 0 ] || sudo_cmd="sudo"
    $sudo_cmd apt-get update
    $sudo_cmd apt-get install -y $pkgs
  else
    die "Tauri needs WebKitGTK 4.1 and its build packages. On Debian or Ubuntu: sudo apt install $pkgs (Fedora: sudo dnf install webkit2gtk4.1-devel openssl-devel libappindicator-gtk3-devel librsvg2-devel libxdo-devel rpm-build)"
  fi
fi

PY=""
for c in python3.14 python3.13 python3.12 python3; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then PY="$(command -v "$c")"; break; fi
done
[ -n "$PY" ] || die "Python 3.12 or newer is needed (macOS: brew install python@3.13, or python.org; Linux: your package manager)"
say "python $("$PY" -c 'import sys; print(sys.version.split()[0])') at $PY"

command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 || die "Node.js 20.19 or newer is needed (https://nodejs.org, or brew install node)"
NODE_V="$(node -p 'process.versions.node')"
node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 20 || (a === 20 && b >= 19) ? 0 : 1)' || die "Node.js $NODE_V is too old; 20.19 or newer is needed"
say "node $NODE_V"

[ -x "$HOME/.cargo/bin/rustc" ] && export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v cargo >/dev/null 2>&1 || ! command -v rustup >/dev/null 2>&1; then
  if command -v cargo >/dev/null 2>&1; then
    say "Rust at $(command -v rustc) is not managed by rustup; Tauri builds expect rustup"
  fi
  if ask "Install Rust with rustup now (https://rustup.rs, into ~/.cargo)?"; then
    command -v curl >/dev/null 2>&1 || die "curl is needed to install Rust"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
    export PATH="$HOME/.cargo/bin:$PATH"
  elif ! command -v cargo >/dev/null 2>&1; then
    die "Rust is needed. Install it from https://rustup.rs (or run ./build --yes), then run ./build again"
  fi
fi
if command -v rustup >/dev/null 2>&1; then
  if [ "$OS" = macos ] && [ "$ARCH" = arm64 ]; then
    rustup toolchain list | grep -q '^stable-aarch64-apple-darwin' || rustup toolchain install stable-aarch64-apple-darwin --profile minimal
    export RUSTUP_TOOLCHAIN=stable-aarch64-apple-darwin
  elif ! rustup show active-toolchain >/dev/null 2>&1; then
    rustup default stable
  fi
fi
unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS CARGO_BUILD_TARGET CARGO_TARGET_DIR RUSTC RUSTC_WRAPPER
RUSTC_V="$(rustc -V | awk '{print $2}')"
CARGO_V="$(cargo -V | awk '{print $2}')"
TRIPLE="$(rustc -vV | awk '/^host:/ {print $2}')"
[ "$RUSTC_V" = "$CARGO_V" ] || die "rustc $RUSTC_V ($(command -v rustc)) and cargo $CARGO_V ($(command -v cargo)) come from different Rust installs. Remove the extra one (for Homebrew: brew uninstall rust) and run ./build again"
case "$OS:$ARCH:$TRIPLE" in
  macos:arm64:aarch64-apple-darwin|macos:x86_64:x86_64-apple-darwin|linux:*) ;;
  *) die "rustc builds for $TRIPLE but this machine is $ARCH. Run: rustup default stable-$( [ "$ARCH" = arm64 ] && echo aarch64 || echo x86_64 )-apple-darwin" ;;
esac
say "rust $RUSTC_V for $TRIPLE ($(command -v rustc))"

if [ "$OS" = macos ]; then
  export PATH="$(dirname "$(command -v rustc)"):/usr/bin:$PATH"
  say "strip $(command -v strip)"
fi

step "preparing"
if [ "$CLEAN" = 1 ]; then
  say "removing earlier build output"
  rm -rf src-tauri/target frontend/dist backend/build backend/dist-engine src-tauri/binaries/formdeck-engine-*
fi
mkdir -p src-tauri/binaries

step "installing the engine's Python packages"
VENV="$ROOT/backend/venv"
VPY="$VENV/bin/python"
if [ -x "$VPY" ] && ! "$VPY" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
  say "the existing venv uses an old Python; recreating it"
  rm -rf "$VENV"
fi
[ -x "$VPY" ] || "$PY" -m venv "$VENV"
if [ "$OS" = macos ]; then REQ=(backend/requirements_macos.txt backend/requirements_desktop_macos.txt); else REQ=(backend/requirements.txt backend/requirements_desktop.txt); fi
REQ_HASH="$(hash_of "${REQ[@]}") $("$VPY" -V 2>&1)"
if [ "$REINSTALL" = 1 ] || [ "$(cat "$VENV/.formdeck-req" 2>/dev/null)" != "$REQ_HASH" ] || ! "$VPY" -c 'import fastapi, pptx, PyInstaller' 2>/dev/null; then
  "$VPY" -m pip install --upgrade pip
  "$VPY" -m pip install -r "${REQ[0]}" -r "${REQ[1]}"
  printf '%s' "$REQ_HASH" > "$VENV/.formdeck-req"
else
  say "up to date"
fi

step "installing the window's npm packages"
LOCK_HASH="$(hash_of frontend/package-lock.json) $NODE_V"
if [ "$REINSTALL" = 1 ] || [ ! -d frontend/node_modules ] || [ "$(cat frontend/node_modules/.formdeck-lock 2>/dev/null)" != "$LOCK_HASH" ]; then
  ( cd frontend && npm ci --no-audit --no-fund )
  printf '%s' "$LOCK_HASH" > frontend/node_modules/.formdeck-lock
else
  say "up to date"
fi
TAURI="$ROOT/frontend/node_modules/.bin/tauri"
[ -x "$TAURI" ] || die "the Tauri CLI did not install; run ./build --reinstall"
CLI_V="$("$TAURI" --version | awk '{print $2}')"
CRATE_V="$(awk '/^name = "tauri"$/ {getline; gsub(/"/, "", $3); print $3; exit}' src-tauri/Cargo.lock)"
[ "${CLI_V%.*}" = "${CRATE_V%.*}" ] || die "the Tauri CLI ($CLI_V) and the tauri crate ($CRATE_V) differ; they must match before Tauri will build"
say "tauri cli $CLI_V, crate $CRATE_V"

step "building the window"
( cd frontend && npm run build )

step "freezing the engine into the app"
SEP=":"
EXTRA=()
[ -d backend/app/fonts ] && EXTRA+=(--add-data "$ROOT/backend/app/fonts${SEP}fonts")
(
  cd backend
  rm -rf build/pyinstaller dist-engine
  "$VPY" -m PyInstaller --noconfirm --clean --onefile --log-level WARN --name formdeck-engine \
    --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
    --add-data "$ROOT/frontend/dist${SEP}frontend_dist" \
    --add-data "$ROOT/addins${SEP}addins" \
    --add-data "$ROOT/backend/app/services/odp/presets.json${SEP}app/services/odp" \
    --collect-submodules app --collect-submodules uvicorn \
    --collect-all pptx --collect-all pdfplumber --hidden-import pypdfium2 --collect-all latex2mathml \
    ${EXTRA[@]+"${EXTRA[@]}"} \
    "$ROOT/backend/formdeck_engine.py"
)
SIDECAR="src-tauri/binaries/formdeck-engine-$TRIPLE"
cp backend/dist-engine/formdeck-engine "$SIDECAR"
chmod +x "$SIDECAR"
"$SIDECAR" --selfcheck >/dev/null || { "$SIDECAR" --selfcheck || true; die "the frozen engine is missing modules (see above)"; }
say "engine ready: $SIDECAR ($(du -h "$SIDECAR" | awk '{print $1}'))"

step "building and bundling the app ($BUNDLES)"
if [ ! -f src-tauri/icons/icon.icns ] || [ ! -f src-tauri/icons/icon.ico ] || [ ! -f src-tauri/icons/128x128.png ]; then
  "$TAURI" icon assets/formdeck_icon.png
fi
TAURI_ARGS=(build --bundles "$BUNDLES")
[ "$DEBUG" = 1 ] && TAURI_ARGS+=(--debug)
LOG="$(mktemp)"
trap 'rm -f "$LOG"' EXIT
run_tauri() {
  set +e
  "$TAURI" "$@" 2>&1 | tee "$LOG"
  local s=${PIPESTATUS[0]}
  set -e
  return "$s"
}
if ! run_tauri "${TAURI_ARGS[@]}"; then
  if grep -q "E0463" "$LOG"; then
    say "Rust could not load a crate it had just built (E0463); clearing the Rust build cache and building again"
    ( cd src-tauri && cargo clean )
    run_tauri "${TAURI_ARGS[@]}" || die "the Rust build failed again; the log above shows the first error"
  elif [ "$OS" = macos ] && grep -qi "dmg" "$LOG" && [ -d "src-tauri/target/$([ "$DEBUG" = 1 ] && echo debug || echo release)/bundle/macos/FormDeck.app" ]; then
    say "the .app was built but the .dmg step failed; the app is usable as is (drag it to Applications)"
  else
    die "the app build failed; the log above shows the first error"
  fi
fi

OUT="src-tauri/target/$([ "$DEBUG" = 1 ] && echo debug || echo release)/bundle"
step "done in $(( (SECONDS - START) / 60 )) min $(( (SECONDS - START) % 60 )) s"
find "$OUT" -maxdepth 2 \( -name '*.dmg' -o -name '*.app' -o -name '*.deb' -o -name '*.rpm' -o -name '*.AppImage' \) 2>/dev/null | while read -r f; do say "$ROOT/$f"; done
if [ "$OS" = macos ]; then
  say "open it: open \"$ROOT/$OUT/macos/FormDeck.app\""
else
  DEB="$(ls -t "$OUT"/deb/*.deb 2>/dev/null | head -n1 || true)"
  [ -n "$DEB" ] && say "install it: sudo apt install ./$DEB" || say "run the .AppImage, or install the .rpm with dnf"
fi
