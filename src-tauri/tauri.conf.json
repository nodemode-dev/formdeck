{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formdeck",
  "version": "0.25.0",
  "identifier": "ai.nodemode.formdeck",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formdeck",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Presentations and decks",
    "longDescription": "formdeck is a presentation editor in the NodeMode design system: slides, layouts, masters and templates in its own .fdec decks, PowerPoint, Keynote and Google Slides exchange through .pptx, PDF export, and agent automation that builds and edits decks in plain language.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formdeck-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "office",
        "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"]
      },
      "rpm": {
        "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "fileAssociations": [
      { "ext": ["fdec"], "name": "formdeck Deck", "description": "formdeck presentation deck", "role": "Editor", "mimeType": "application/x-formdeck" },
      { "ext": ["fsld"], "name": "formdeck Deck (older)", "description": "formdeck presentation deck saved by formsld", "role": "Editor", "mimeType": "application/x-formsld" },
      { "ext": ["pptx"], "name": "PowerPoint Presentation", "description": "PowerPoint presentation", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation" },
      { "ext": ["odp"], "name": "OpenDocument Presentation", "description": "OpenDocument presentation", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.oasis.opendocument.presentation" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formdeck/releases/latest/download/latest.json"]
    }
  }
}
