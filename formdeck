#!/usr/bin/env bash
set -e
FORMDECK_CALLER_DIR="$PWD"
export FORMDECK_CALLER_DIR
cd "$(dirname "$0")"
usage() {
  printf 'formdeck %s · presentation editor\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'EOF'

usage: ./formdeck [command] [options]

  (none) | boot       boot backend (8197) and frontend (5197) together
  install [--lite]    install backend and frontend
  install-desktop     install PyInstaller and check the Rust and Tauri toolchain
  backend             boot the backend only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the backend on 127.0.0.1:8197
  freeze              freeze the backend into the Tauri sidecar binary
  desktop dev|build|check  run, bundle (the same as ./build_app) or check the toolchain for the desktop app
  doctor              check the toolchain, installs and ports
  claude [args]       Claude Code in this terminal with FormDeck's MCP tools attached
  cli list|describe|run|batch  the editor's command catalogue from a terminal: list [text], run <id> (the window must be open)
  i18n check|scan|export|import  the translations: check for gaps, find new strings, or a language as CSV for a native reviewer and back
  pdf-check FILE.pdf  validate an exported PDF as PDF/UA-1 with veraPDF (installed separately, needs Java)
  mcp                 formdeck over MCP's stdio transport, for Claude Desktop and other MCP clients
  agents install|sync  set up Claude Code, Codex and Cursor for building decks in plain language (install), or refresh the skill (sync)
  build-deck [args]   build a deck from files headlessly, without the window
  templates export [dir]  write the built-in templates as .pptx files
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      check) exec setup/desktop_check "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  claude) exec python3 setup/claude_launch.py "$@" ;;
  cli) exec python3 setup/catalogue.py "$@" ;;
  i18n) exec python3 setup/i18n_tool.py "$@" ;;
  pdf-check) exec python3 setup/pdf_check.py "$@" ;;
  mcp) exec python3 setup/mcp_stdio.py "$@" ;;
  agents) exec python3 setup/agents.py "$@" ;;
  build-deck) exec setup/build_deck "$@" ;;
  templates) exec setup/templates "$@" ;;
  clean) exec setup/clean "$@" ;;
  help|-h|--help) usage ;;
  *) printf '[formdeck] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
