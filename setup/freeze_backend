#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fd_venv
python -c "import PyInstaller" 2>/dev/null || fd_die "PyInstaller missing, run ./formdeck install-desktop"
triple="$(fd_target_triple)" || fd_die "rustc not found; install Rust or set FORMDECK_TARGET"
[ -f "$FORMDECK_ROOT/frontend/dist/index.html" ] || "$FORMDECK_ROOT/setup/build_frontend"
cd "$FORMDECK_ROOT/backend"
sep=":"
[ "$(fd_os)" = windows ] && sep=";"
ext="$(fd_exe)"
extra=()
if [ -d "$FORMDECK_ROOT/backend/app/fonts" ]; then extra+=(--add-data "$FORMDECK_ROOT/backend/app/fonts${sep}fonts"); fi
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean --onefile --name formdeck-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$FORMDECK_ROOT/frontend/dist${sep}frontend_dist" \
  --add-data "$FORMDECK_ROOT/addins${sep}addins" \
  --collect-submodules app --collect-submodules uvicorn \
  --collect-all pptx --collect-all pdfplumber --hidden-import pypdfium2 \
  --collect-all latex2mathml --add-data "$FORMDECK_ROOT/backend/app/services/odp/presets.json${sep}app/services/odp" \
  "${extra[@]}" \
  "$FORMDECK_ROOT/backend/formdeck_engine.py"
mkdir -p "$FORMDECK_ROOT/src-tauri/binaries"
out="$FORMDECK_ROOT/src-tauri/binaries/formdeck-engine-${triple}${ext}"
cp "dist-engine/formdeck-engine${ext}" "$out"
"$out" --selfcheck
fd_say "sidecar ready: $out"
