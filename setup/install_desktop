#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fs_venv
cd "$FORMSLD_ROOT/backend"
if [ "$(fs_os)" = macos ]; then pip install -r requirements_desktop_macos.txt; else pip install -r requirements_desktop.txt; fi
if ! command -v cargo >/dev/null 2>&1; then
  fs_say "Rust is not installed. Install it from https://rustup.rs then rerun ./formsld install-desktop"
  exit 1
fi
if [ "$(fs_os)" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  fs_say "Tauri needs system libraries. On Debian or Ubuntu run:"
  fs_say "sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf"
  exit 1
fi
[ -x "$FORMSLD_ROOT/frontend/node_modules/.bin/tauri" ] || ( cd "$FORMSLD_ROOT/frontend" && npm install )
fs_say "desktop toolchain ready: rustc $(rustc --version | awk '{print $2}')"
