#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
triple="$(fd_target_triple)" || fd_die "rustc not found; run ./formdeck install-desktop"
[ -x "$FORMDECK_ROOT/src-tauri/binaries/formdeck-engine-${triple}$(fd_exe)" ] || "$FORMDECK_ROOT/setup/freeze_backend"
cd "$FORMDECK_ROOT"
exec frontend/node_modules/.bin/tauri dev "$@"
