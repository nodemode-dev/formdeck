#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
[ -f "$FORMSLD_ROOT/frontend/dist/index.html" ] || "$FORMSLD_ROOT/setup/build_frontend"
fs_venv
cd "$FORMSLD_ROOT/backend"
export FORMSLD_DIST="$FORMSLD_ROOT/frontend/dist"
fs_say "serving http://${FORMSLD_HOST:-127.0.0.1}:${FORMSLD_PORT:-8197}"
exec uvicorn app.main:app --host "${FORMSLD_HOST:-127.0.0.1}" --port "${FORMSLD_PORT:-8197}"
